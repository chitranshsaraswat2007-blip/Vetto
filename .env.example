# Core
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/vetto?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
VETTO_DEMO_ACCESS_ENABLED="false"

# Storage - use local for development, s3 for production
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# AI reasoning - optional; deterministic analysis works without it
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
